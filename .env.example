# Copy to .env and fill in. Every value is required: there are no inline
# fallbacks, so a missing value is an error rather than a silent default.

SPARQL_URL_BASE=http://localhost:3031
SPARQL_DATASET=dim
SPARQL_USER=admin
SPARQL_PASSWORD=admin

OLLAMA_URL=http://localhost:11434

# Optional: enables writing (notes, tags, links) from the web UI and API.
# 16+ characters; log in at /login with it, or send it as a Bearer token.
# Without it the server is read-only. e.g.  openssl rand -base64 24
# DIM_WRITE_TOKEN=

# Optional (the one exception to "every value is required"): a read-only
# GitHub token lifts the enrichment API limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN=

# Optional: remote LLMs for enrichment summaries (bin/enrich.js --summariser remote).
#
# Rotation (recommended): providers in order of preference; each bookmark goes
# to the first one available, and a 429/503 moves on to the next while the
# first cools down. Providers without a key are skipped. Key names match
# danja/peasant. Known: mistral, groq, openrouter, google, huggingface, nvidia.
# Per provider, <NAME>_MODEL / <NAME>_BASE_URL / <NAME>_MAX_TOKENS override.
# LLM_PROVIDERS=mistral,groq,openrouter
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# NVIDIA_API_KEY=
#
# Or a single endpoint (used when LLM_PROVIDERS is not set):
# Optional: a remote OpenAI-compatible LLM for enrichment summaries
# (bin/enrich.js --summariser remote) — e.g. OpenCode Zen, OpenRouter, Groq.
# Page text is sent to the provider; check its terms for free tiers.
# LLM_BASE_URL=https://provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_MAX_TOKENS=      # optional; raise (e.g. 2048) for thinking models such as Gemini Flash
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#         LLM_MODEL=gemini-flash-latest

APP_PORT=4110
FUSEKI_PORT=3031
OLLAMA_PORT=11434

# Bookmarks saved in DIM (Squirt capture, News "save as bookmark") are
# fetched (the link check), summarised and embedded in the background as
# they are saved. The summariser: ollama (local, OLLAMA_URL), remote (the
# LLM_* settings above) or extractive (offline, no LLM). Default: ollama.
# An LLM that fails falls back to the offline summarisers. AUTO_ENRICH=0: off.
# ENRICH_SUMMARISER=remote
# AUTO_ENRICH=0

# News: poll due feeds from the server every N minutes (0 or unset: off;
# then poll with `node bin/news.js poll` or the Feeds page). Each feed is
# still fetched at most hourly (NEWS_CONFIG in config/preferences.js).
# NEWS_POLL_MINUTES=15

# Blog: name and author for pages and the Atom feed; the public URL the
# static export (bin/blog-export.js) will be hosted at.
# BLOG_TITLE=My blog
# BLOG_AUTHOR=Your Name
# BLOG_BASE_URL=https://example.org/blog/

# Reaching DIM from elsewhere (e.g. a phone through Tailscale or Caddy) —
# see docs/deployment.md and docs/security.md:
# DIM_ORIGIN=https://dim.example.ts.net
# DIM_PRIVATE=1        # every page needs a login; set it whenever DIM is reachable beyond this machine

# Cross-facet "Related": the server embeds what changed every RELATED_SYNC_MINUTES (default 30, 0 = off);
# the first full run is quicker by hand: node bin/related.js
# RELATED_SYNC_MINUTES=30

# Logging: LOG_LEVEL=info|debug, LOG_FORMAT=json (one object per line), LOG_REQUESTS=1
# Backups: BACKUP_DIR=data/backups (tools), BACKUP_HOST_DIR=./backups (compose)
