# Copy to .env and fill in. Every value is required: there are no inline
# fallbacks, so a missing value is an error rather than a silent default.

SPARQL_URL_BASE=http://localhost:3031
SPARQL_DATASET=dim
SPARQL_USER=admin
SPARQL_PASSWORD=admin

OLLAMA_URL=http://localhost:11434

# Optional (the one exception to "every value is required"): a read-only
# GitHub token lifts the enrichment API limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN=

# Optional: remote LLMs for enrichment summaries (bin/enrich.js --summariser remote).
#
# Rotation (recommended): providers in order of preference; each bookmark goes
# to the first one available, and a 429/503 moves on to the next while the
# first cools down. Providers without a key are skipped. Key names match
# danja/peasant. Known: mistral, groq, openrouter, google, huggingface, nvidia.
# Per provider, <NAME>_MODEL / <NAME>_BASE_URL / <NAME>_MAX_TOKENS override.
# LLM_PROVIDERS=mistral,groq,openrouter
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# NVIDIA_API_KEY=
#
# Or a single endpoint (used when LLM_PROVIDERS is not set):
# Optional: a remote OpenAI-compatible LLM for enrichment summaries
# (bin/enrich.js --summariser remote) — e.g. OpenCode Zen, OpenRouter, Groq.
# Page text is sent to the provider; check its terms for free tiers.
# LLM_BASE_URL=https://provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_MAX_TOKENS=      # optional; raise (e.g. 2048) for thinking models such as Gemini Flash
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#         LLM_MODEL=gemini-flash-latest

APP_PORT=4110
FUSEKI_PORT=3031
OLLAMA_PORT=11434
