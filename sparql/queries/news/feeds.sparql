# Every feed with its subscription details and last poll, one row each.
SELECT ?feed ?url ?title ?siteUrl ?created ?format ?status ?lastPolled ?nextPoll ?failures ?lastError ?httpStatus ?etag ?lastModified ?parked
       (GROUP_CONCAT(DISTINCT ?tag; separator=", ") AS ?tags)
WHERE {
  GRAPH ${graph} {
    ?feed a dim:Feed ; dim:feedUrl ?url ; dcterms:title ?title .
    OPTIONAL { ?feed dim:siteUrl ?siteUrl }
    OPTIONAL { ?feed dcterms:created ?created }
    OPTIONAL { ?feed dim:feedFormat ?format }
    OPTIONAL { ?feed dim:pollStatus ?status }
    OPTIONAL { ?feed dim:lastPolled ?lastPolled }
    OPTIONAL { ?feed dim:nextPoll ?nextPoll }
    OPTIONAL { ?feed dim:pollFailures ?failures }
    OPTIONAL { ?feed dim:lastError ?lastError }
    OPTIONAL { ?feed dim:httpStatus ?httpStatus }
    OPTIONAL { ?feed dim:etag ?etag }
    OPTIONAL { ?feed dim:lastModifiedHeader ?lastModified }
    OPTIONAL { ?feed dim:feedParked ?parked }
    OPTIONAL { ?feed dim:tag ?tag }
  }
}
GROUP BY ?feed ?url ?title ?siteUrl ?created ?format ?status ?lastPolled ?nextPoll ?failures ?lastError ?httpStatus ?etag ?lastModified ?parked
