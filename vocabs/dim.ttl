@prefix dim:      <http://purl.org/stuff/dim/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix schema:  <https://schema.org/> .

dim: a owl:Ontology ;
    rdfs:label "DIM vocabulary" ;
    rdfs:comment "Terms for Danny's Information Manager. Bookmarks use dim:Bookmark; retrieval types and topics are SKOS concepts in dim:bookmark-types." ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

## ── Bookmarks ─────────────────────────────────────────────────────────────
dim:Bookmark a owl:Class ; rdfs:label "Bookmark" ;
    rdfs:comment "One URL from the source file, with its link text and first-pass retrieval metadata." .

dim:url a owl:ObjectProperty ; rdfs:domain dim:Bookmark ;
    rdfs:comment "The canonical bookmark URL. Identity of the bookmark." .
dim:linkText a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Link text from the source file." .
dim:bookmarkType a owl:ObjectProperty ; rdfs:domain dim:Bookmark ; rdfs:range skos:Concept ;
    rdfs:comment "First-pass type of the target (github-repo, arxiv-paper, ...). A concept in dim:bookmark-types." .
dim:contentType a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string .
dim:httpStatus a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:integer .
dim:retrievedAt a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:dateTime .
dim:domain a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string .
dim:context a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Outline context from workflowy.md where the link appeared." .
dim:sourceLine a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:integer .
dim:tag a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string .

## ── Second-pass enrichment (docs/enricher.md) ────────────────────────────
## Summaries are derived, not quoted: short plain-text abstracts of the
## target produced by fetch → extract → summarise. Raw extracted text lives
## in data/cache/enrichment/, never in triples.
dim:summary a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Second-pass summary of the target, at most 1000 chars." .
dim:keyword a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Second-pass key term for the target, lower-cased. Repeatable; from the LLM reply or frequency extraction." .
dim:summaryMarkdown a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Second-pass summary as a short markdown document, at most 4000 chars. Composed locally in a fixed shape." .
dim:summaryModel a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Summariser id that produced dim:summary, e.g. ollama/qwen2.5:3b-v1 or extractive-v1." .
dim:summarisedAt a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:dateTime .
dim:contentHash a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "sha256 (hex, 16 chars) of the extracted text the summary was built from." .
dim:contentLength a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:integer .
dim:fetchStatus a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:integer ;
    rdfs:comment "HTTP status of the enrichment fetch, any three-digit code; a refusal (401/403/404/410/429/451, or 999) is recorded, not retried." .

## ── Catalogue details per type (src/gnamgnam/Catalogue.js) ─────────────
## URL-derived at ingest: githubOwner, githubRepo, arxivId, wikipediaLanguage,
## wikipediaTitle. API-reported at enrichment (replaced on each patch):
## githubLanguage, githubStars, githubTopic, arxivAuthor, arxivCategory.
dim:githubOwner a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Owner (user or organisation) of a GitHub repository bookmark, from the URL." .
dim:githubRepo a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Repository name of a GitHub repository bookmark, from the URL." .
dim:githubLanguage a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Primary language reported by the GitHub API." .
dim:githubStars a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:integer ;
    rdfs:comment "Stargazer count reported by the GitHub API when enriched." .
dim:githubTopic a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Repository topic reported by the GitHub API. Repeatable." .
dim:arxivId a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "arXiv identifier without version, from the URL." .
dim:arxivAuthor a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Author name reported by the arXiv API. Repeatable." .
dim:arxivCategory a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "arXiv subject category (e.g. cs.AI) reported by the arXiv API. Repeatable." .
dim:wikipediaLanguage a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Language code of a Wikipedia article bookmark, from the URL." .
dim:wikipediaTitle a owl:DatatypeProperty ; rdfs:domain dim:Bookmark ; rdfs:range xsd:string ;
    rdfs:comment "Article title of a Wikipedia bookmark, from the URL." .

## ── Dead links ───────────────────────────────────────────────────────────
## Link status (ok / dead / error / unchecked) is derived from dim:httpStatus
## and dim:fetchStatus, not stored. schema:archivedAt holds a Wayback Machine
## snapshot found by bin/deadlinks.js --wayback.

## ── Catalogue administration (mirrors plugin-universe, dim: namespace) ────
dim:SourceGraph a owl:Class ; rdfs:label "Source Graph" .
dim:graphKind a owl:DatatypeProperty ; rdfs:domain dim:SourceGraph ; rdfs:range xsd:string .
dim:redistributable a owl:DatatypeProperty ; rdfs:domain dim:SourceGraph ; rdfs:range xsd:boolean .
dim:inCC0Dump a owl:DatatypeProperty ; rdfs:domain dim:SourceGraph ; rdfs:range xsd:boolean .
dim:precedence a owl:DatatypeProperty ; rdfs:domain dim:SourceGraph ; rdfs:range xsd:integer .
dim:harvestRun a owl:DatatypeProperty ; rdfs:domain dim:SourceGraph ; rdfs:range xsd:string .

## ── Embedding bookkeeping ─────────────────────────────────────────────────
dim:embeddingModel a owl:DatatypeProperty ; rdfs:range xsd:string .
dim:embeddingDimension a owl:DatatypeProperty ; rdfs:range xsd:integer .
dim:embeddedAtTime a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
dim:composedTextHash a owl:DatatypeProperty ; rdfs:range xsd:string .
