@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dim:     <http://purl.org/stuff/dim/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <https://schema.org/> .
@prefix sioc:    <http://rdfs.org/sioc/ns#> .

dim:shapes a owl:Ontology ;
    rdfs:label "DIM validation shapes" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

dim:BookmarkShape a sh:NodeShape ;
    sh:targetClass dim:Bookmark ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
        sh:message "A bookmark needs exactly one non-empty label." ;
    ] ;
    sh:property [
        sh:path dim:url ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https?://" ;
        sh:message "dim:url is the canonical URL as an IRI." ;
    ] ;
    sh:property [
        sh:path dim:bookmarkType ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.org/stuff/dim/concept/" ;
        sh:message "Bookmark types are concepts in dim:bookmark-types." ;
    ] ;
    sh:property [
        sh:path dim:httpStatus ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 100 ; sh:maxInclusive 999 ;
        sh:message "A three-digit HTTP status as the server sent it; non-standard codes such as 999 are real." ;
    ] ;
    sh:property [
        sh:path dim:tag ;
        sh:datatype xsd:string ; sh:minLength 1 ;
        sh:pattern "^[^A-Z]*$" ;
        sh:message "Tags are lower-cased at normalisation." ;
    ] ;
    sh:property [
        sh:path dim:summary ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 1000 ;
        sh:message "dim:summary is at most one short derived abstract." ;
    ] ;
    sh:property [
        sh:path dim:summaryModel ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:keyword ;
        sh:datatype xsd:string ; sh:minLength 2 ;
        sh:pattern "^[^A-Z]*$" ;
        sh:message "Keywords are lower-cased at summarisation." ;
    ] ;
    sh:property [
        sh:path dim:summaryMarkdown ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 4000 ;
        sh:message "dim:summaryMarkdown is at most one short markdown document." ;
    ] ;
    sh:property [
        sh:path dim:summarisedAt ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:property [
        sh:path dim:contentHash ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:contentLength ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path dim:fetchStatus ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 100 ; sh:maxInclusive 999 ;
        sh:message "A three-digit HTTP status as the server sent it; non-standard codes such as 999 are real." ;
    ] ;
    sh:property [
        sh:path dim:githubOwner ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:githubRepo ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:githubLanguage ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:arxivId ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:wikipediaLanguage ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:wikipediaTitle ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:githubTopic ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:arxivAuthor ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:arxivCategory ;
        sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path dim:githubStars ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path schema:archivedAt ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://web\\.archive\\.org/" ;
        sh:message "schema:archivedAt is one Wayback Machine snapshot URL." ;
    ] .

## Authored data (Phase 4). Facet graphs carry no rdf:type for resources
## typed elsewhere, so these target by property rather than by class.
dim:TaggedShape a sh:NodeShape ;
    sh:targetSubjectsOf dim:tag ;
    sh:property [
        sh:path dim:tag ;
        sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 60 ;
        sh:pattern "^[^A-Z]*$" ;
        sh:message "Tags are short and lower-case." ;
    ] .

dim:NotedShape a sh:NodeShape ;
    sh:targetSubjectsOf dim:note ;
    sh:property [
        sh:path dim:note ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 20000 ;
        sh:message "One note per resource per facet, at most 20,000 characters." ;
    ] .

dim:LinkShape a sh:NodeShape ;
    sh:targetSubjectsOf dim:relatedTo, dim:resource, dim:mentions, dim:partOf ;
    sh:property [ sh:path dim:relatedTo ; sh:nodeKind sh:IRI ; sh:message "Links point at IRIs." ] ;
    sh:property [ sh:path dim:resource ; sh:nodeKind sh:IRI ; sh:message "Links point at IRIs." ] ;
    sh:property [ sh:path dim:mentions ; sh:nodeKind sh:IRI ; sh:message "Links point at IRIs." ] ;
    sh:property [ sh:path dim:partOf ; sh:nodeKind sh:IRI ; sh:message "Links point at IRIs." ] .

## Outlines (Trestle).
dim:OutlineShape a sh:NodeShape ;
    sh:targetClass dim:Outline ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ;
        sh:message "An outline has one title, at most 200 characters." ;
    ] .

dim:OutlineNodeShape a sh:NodeShape ;
    sh:targetClass dim:OutlineNode ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:maxLength 4000 ;
        sh:message "A node has one title (it may be empty), at most 4000 characters." ;
    ] ;
    sh:property [
        sh:path dim:inOutline ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A node belongs to exactly one outline." ;
    ] ;
    sh:property [
        sh:path dim:partOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A node has exactly one parent: a node, or the outline itself." ;
    ] ;
    sh:property [
        sh:path dim:position ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "A node has one decimal position among its siblings." ;
    ] ;
    sh:property [
        sh:path dim:collapsed ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .

## Tasks (Farelo).
dim:TaskShape a sh:NodeShape ;
    sh:targetClass dim:Task ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 500 ;
        sh:message "A task has one title of 1–500 characters." ;
    ] ;
    sh:property [
        sh:path dim:status ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.org/stuff/dim/task-state/(backlog|todo|doing|blocked|done)$" ;
        sh:message "A task has one state: backlog, todo, doing, blocked or done." ;
    ] ;
    sh:property [
        sh:path dim:priority ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 5 ;
        sh:message "Priority is 1 (highest) to 5 (lowest)." ;
    ] ;
    sh:property [ sh:path dim:due ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:message "One due date (YYYY-MM-DD)." ] ;
    sh:property [ sh:path dim:estimate ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:message "Estimate is whole minutes." ] ;
    sh:property [ sh:path dim:dependsOn ; sh:nodeKind sh:IRI ; sh:pattern "^http://purl\\.org/stuff/dim/task/" ; sh:message "A task depends on other tasks." ] ;
    sh:property [ sh:path dim:partOf ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "A task is part of at most one project." ] ;
    sh:property [ sh:path dim:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path dim:doneAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

## Wiki.
dim:WikiPageShape a sh:NodeShape ;
    sh:targetClass dim:WikiPage ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ; sh:message "A page has one title of 1–200 characters." ] ;
    sh:property [ sh:path sioc:content ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 200000 ; sh:message "A page has one text (Markdown), at most 200,000 characters." ] ;
    sh:property [ sh:path dim:revisionNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path dim:currentRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

dim:PageRevisionShape a sh:NodeShape ;
    sh:targetClass dim:PageRevision ;
    sh:property [ sh:path dim:revisionOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dim:revisionNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sioc:content ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path prov:wasRevisionOf ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

dim:FeedShape a sh:NodeShape ;
    sh:targetClass dim:Feed ;
    sh:property [ sh:path dim:feedUrl ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^https?://" ; sh:message "A feed has one http(s) URL." ] ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 300 ] ;
    sh:property [ sh:path dim:siteUrl ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dim:feedFormat ; sh:maxCount 1 ; sh:in ( "rss" "rdf" "atom" "json" ) ] ;
    sh:property [ sh:path dim:pollStatus ; sh:maxCount 1 ; sh:in ( "new" "ok" "not-modified" "error" "refused" "gone" ) ] ;
    sh:property [ sh:path dim:pollFailures ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path dim:lastPolled ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path dim:nextPoll ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path dim:httpStatus ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 100 ; sh:maxInclusive 999 ] ;
    sh:property [ sh:path dim:tag ; sh:datatype xsd:string ; sh:pattern "^[^A-Z]*$" ] .

dim:FeedItemShape a sh:NodeShape ;
    sh:targetClass dim:FeedItem ;
    sh:property [ sh:path dim:inFeed ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 500 ] ;
    sh:property [ sh:path schema:url ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^https?://" ] ;
    sh:property [ sh:path dim:guid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:description ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 4000 ] ;
    sh:property [ sh:path dcterms:issued ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path dcterms:created ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "When the item was first seen." ] .

dim:BlogPostShape a sh:NodeShape ;
    sh:targetClass dim:BlogPost ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ; sh:message "A post has one title of 1–200 characters." ] ;
    sh:property [ sh:path sioc:content ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 200000 ] ;
    sh:property [ sh:path dim:slug ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z0-9][a-z0-9-]*$" ] ;
    sh:property [ sh:path dim:postStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "draft" "published" ) ] ;
    sh:property [ sh:path dcterms:issued ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "The publication date: set when first published." ] ;
    sh:property [ sh:path dcterms:abstract ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 1000 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dim:tag ; sh:datatype xsd:string ; sh:pattern "^[^A-Z]*$" ] .

dim:ConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

dim:SourceGraphShape a sh:NodeShape ;
    sh:targetClass dim:SourceGraph ;
    sh:property [
        sh:path dcterms:license ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
                "CC0-1.0" "Unlicense" "0BSD" "MIT" "ISC" "BSD-2-Clause" "BSD-3-Clause"
                "Apache-2.0" "BSL-1.0" "Zlib" "MPL-2.0" "GPL-2.0" "GPL-3.0" "LGPL-2.1"
                "LGPL-3.0" "AGPL-3.0" "CC-BY-4.0" "CC-BY-SA-4.0" "proprietary-linkout"
                "personal-data" "unknown"
        ) ;
    ] ;
    sh:property [
        sh:path dim:redistributable ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;
    sh:property [
        sh:path dim:inCC0Dump ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;
    sh:property [
        sh:path dim:precedence ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] .
