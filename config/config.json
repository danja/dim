{
  "baseUri": "http://purl.org/stuff/dim/",
  "site": {
    "domain": "localhost",
    "origin": "http://localhost:4110"
  },
  "storage": {
    "type": "sparql",
    "endpoint": {
      "label": "local",
      "urlBase": "${SPARQL_URL_BASE}",
      "dataset": "${SPARQL_DATASET}",
      "query": "${SPARQL_URL_BASE}/${SPARQL_DATASET}/query",
      "update": "${SPARQL_URL_BASE}/${SPARQL_DATASET}/update",
      "user": "${SPARQL_USER}",
      "password": "${SPARQL_PASSWORD}"
    }
  },
  "embedding": {
    "provider": "ollama",
    "baseUrl": "${OLLAMA_URL}",
    "model": "nomic-embed-text:v1.5",
    "dimension": 768
  },
  "index": {
    "path": "data/dim.index"
  },
  "sources": {
    "workflowy": {
      "file": "data/workflowy.md",
      "cachePath": "data/cache/retrieval.json"
    }
  },
  "app": {
    "defaultFacet": "gnamgnam"
  }
}
